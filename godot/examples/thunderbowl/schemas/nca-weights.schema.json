{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Thunderbowl v1 nca weights",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "architecture": {
      "const": "graph_residual_12_8_4"
    },
    "training_status": {
      "enum": [
        "untrained",
        "trained_external"
      ]
    },
    "weights_in": {
      "type": "array",
      "minItems": 96,
      "maxItems": 96,
      "items": {
        "type": "number",
        "minimum": -4,
        "maximum": 4
      }
    },
    "bias_in": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "number",
        "minimum": -4,
        "maximum": 4
      }
    },
    "weights_out": {
      "type": "array",
      "minItems": 32,
      "maxItems": 32,
      "items": {
        "type": "number",
        "minimum": -4,
        "maximum": 4
      }
    },
    "bias_out": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number",
        "minimum": -4,
        "maximum": 4
      }
    }
  },
  "required": [
    "version",
    "architecture",
    "training_status",
    "weights_in",
    "bias_in",
    "weights_out",
    "bias_out"
  ],
  "additionalProperties": false
}
