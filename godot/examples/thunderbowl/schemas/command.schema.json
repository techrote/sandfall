{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Thunderbowl v1 command",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "actor_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "observed_tick": {
      "type": "integer",
      "minimum": 0,
      "maximum": 36000
    },
    "observation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "lease_ticks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18
    },
    "kind": {
      "enum": [
        "rig_action",
        "actuator_action"
      ]
    },
    "action": {},
    "tag": {
      "type": "boolean"
    },
    "message": {
      "oneOf": [
        {
          "type": "array",
          "minItems": 0,
          "maxItems": 0,
          "items": {}
        },
        {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          }
        }
      ]
    },
    "message_type": {
      "enum": [
        "none",
        "goal_hint",
        "latent_state"
      ]
    },
    "cancel": {
      "type": "boolean"
    }
  },
  "required": [
    "version",
    "run_id",
    "actor_id",
    "epoch",
    "sequence",
    "observed_tick",
    "observation_id",
    "lease_ticks",
    "kind",
    "action",
    "tag",
    "message",
    "message_type",
    "cancel"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "rig_action"
          }
        }
      },
      "then": {
        "properties": {
          "action": {
            "type": "object",
            "properties": {
              "movement": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number",
                  "minimum": -1,
                  "maximum": 1
                }
              },
              "aim": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number",
                  "minimum": -1,
                  "maximum": 1
                }
              },
              "effort": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "trim": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              },
              "reel": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              },
              "primary": {
                "type": "boolean"
              },
              "secondary": {
                "type": "boolean"
              },
              "auxiliary": {
                "type": "boolean"
              }
            },
            "required": [
              "movement",
              "aim",
              "effort",
              "trim",
              "reel",
              "primary",
              "secondary",
              "auxiliary"
            ],
            "additionalProperties": false
          }
        }
      },
      "else": {
        "properties": {
          "action": {
            "type": "object",
            "properties": {
              "actuators": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "number",
                  "minimum": -1,
                  "maximum": 1
                }
              },
              "tag_aim": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number",
                  "minimum": -1,
                  "maximum": 1
                }
              }
            },
            "required": [
              "actuators",
              "tag_aim"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "message_type": {
            "const": "none"
          }
        }
      },
      "then": {
        "properties": {
          "message": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "message": {
            "minItems": 4
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "cancel": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "tag": {
            "const": false
          },
          "message_type": {
            "const": "none"
          },
          "message": {
            "maxItems": 0
          },
          "action": {
            "enum": [
              {
                "movement": [
                  0,
                  0
                ],
                "aim": [
                  0,
                  0
                ],
                "effort": 0,
                "trim": 0,
                "reel": 0,
                "primary": false,
                "secondary": false,
                "auxiliary": false
              },
              {
                "actuators": [
                  0,
                  0,
                  0,
                  0
                ],
                "tag_aim": [
                  0,
                  0
                ]
              }
            ]
          }
        }
      }
    }
  ],
  "$comment": "Shape validation only. The arena validates assigned lane/profile, issued observation token, producer, run, epoch, monotonic sequence, lease, liveness and communication privilege. Typed motor channels may clamp to profile-specific unipolar limits."
}
